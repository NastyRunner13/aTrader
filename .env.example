# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# OpenRouter key (https://openrouter.ai/keys). Only zero-priced ":free" routes are used.
OPENROUTER_API_KEY=

# Models. Run `atrader models` to see which free routes are eligible today.
# openrouter/free picks any free model; an explicit ID gives more repeatable reports.
ATRADER_QUICK_MODEL=openrouter/free
ATRADER_DEEP_MODEL=openrouter/free

# Your account's daily free-model allowance, and how much to hold back.
# 50/day by default on OpenRouter; 1000/day after a one-time $10 credit purchase.
ATRADER_DAILY_REQUEST_LIMIT=50
ATRADER_DAILY_REQUEST_RESERVE=10

# Optional: where databases, caches and checkpoints live (default: %LOCALAPPDATA%\atrader).
# Keep this outside OneDrive.
# ATRADER_DATA_DIR=

# Price history to keep per run, in sessions (200-day averages need about 250+).
# ATRADER_PRICE_HISTORY_SESSIONS=300
